{
  "manifest_version": 3,
  "name": "TabTidy 本机同步",
  "version": "0.1.0",
  "description": "把 Chrome 或 Edge 的普通窗口标签页标题和网址同步到本机 TabTidy 桌面应用。",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "incognito": "not_allowed",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "TabTidy 本机同步", "default_popup": "popup.html" }
}
